DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/podcast_aggregator
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Comma-separated ISO-3166 alpha-2 markets collected by the daily chart task.
CHART_COUNTRIES=US,GB,CA,AU,DE,AZ,TR
# Spotify currently supports this subset of the configured markets.
CHART_SPOTIFY_COUNTRIES=US,GB,CA,AU,DE

PODCHASER_ENABLED=false
PODCHASER_CHARTS_URL=https://www.podchaser.com/charts
PODCHASER_USER_AGENT=PodcastAggregator/0.1
